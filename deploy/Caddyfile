# Stack-owned web server. Plain HTTP on PM_BIND:PM_PORT (see compose.yaml).
# TLS terminates at a reverse proxy on your LAN, which forwards here. Never expose this app to the internet.
{
	admin off
	auto_https off
	servers {
		# The external reverse proxy sets X-Forwarded-*; trust it only from private ranges.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
